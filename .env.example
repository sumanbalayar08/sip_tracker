# Google service account (GCP → IAM → Service accounts → Keys → JSON)
GOOGLE_SA_EMAIL=sip-tracker@your-project.iam.gserviceaccount.com
# Either the private_key value from the JSON (keep the \n escapes) or that PEM base64-encoded:
#   node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"
GOOGLE_SA_KEY=

# The ID from https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Login password for the app
APP_PASSWORD=
# 32+ random characters for the session cookie:  openssl rand -base64 32
SESSION_PASSWORD=
